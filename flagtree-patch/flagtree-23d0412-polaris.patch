diff --git a/python/triton/compiler/code_generator.py b/python/triton/compiler/code_generator.py
index 6ad769c..69a291d 100644
--- a/python/triton/compiler/code_generator.py
+++ b/python/triton/compiler/code_generator.py
@@ -933,6 +933,15 @@ class CodeGenerator(ast.NodeVisitor):
         lb = language.core._to_tensor(lb, self.builder)
         ub = language.core._to_tensor(ub, self.builder)
         step = language.core._to_tensor(step, self.builder)
+        # [polaris] 循环边界必须是标量。若是张量（例如 tl.load 读出的 per-lane
+        # 次数），dtype.is_int() 只看元素类型会放行，随后 MLIR 在
+        # getIntOrFloatBitWidth 上断言失败、整个进程崩溃，没有任何诊断。
+        for _nm, _v in (("lower bound", lb), ("upper bound", ub), ("step", step)):
+            if _v.type.is_block():
+                raise TypeError(
+                    f"For loop {_nm} must be a scalar, got a tensor of type {_v.type}. "
+                    "Per-lane (data-dependent) trip counts are not supported: "
+                    "every lane must run the same number of iterations.")
         # induction variable type
         if not lb.dtype.is_int() or not ub.dtype.is_int() or not step.dtype.is_int():
             raise TypeError(f"For loop bounds and step must all be ints, are ({lb.dtype}, {ub.dtype}, {step.dtype})")
diff --git a/python/setup_tools/utils/polaris.py b/python/setup_tools/utils/polaris.py
new file mode 100644
index 0000000..29826f8
--- /dev/null
+++ b/python/setup_tools/utils/polaris.py
@@ -0,0 +1,54 @@
+"""
+FlagTree setup config module for PolarisGPU backend.
+
+PolarisGPU 后端的 C++ 部分（PolarisGPUTransforms 中的 MLIR pass）编进 libtriton，
+由 TRITON_CODEGEN_BACKENDS 驱动，不需要额外下载依赖。
+本模块提供 FlagTree setup_helper 期望的配置接口（均为 no-op / 本地默认）。
+"""
+import os
+
+
+def skip_package_dir(package):
+    return False
+
+
+def get_resources_url(resource_name):
+    # polaris 用本地 LLVM_SYSPATH，无需下载
+    return None
+
+
+def get_resources_hash(resource_name):
+    return None
+
+
+def get_backend_cmake_args(*args, **kargs):
+    # polaris 的 C++ 编进 libtriton 由 TRITON_CODEGEN_BACKENDS 驱动，无需额外 cmake 参数
+    return []
+
+
+def get_extra_install_packages():
+    return []
+
+
+def get_package_data_tools():
+    return []
+
+
+def configure_packages_and_data(packages, package_dir, package_data, deps_dir):
+    return packages, package_dir, package_data
+
+
+def get_package_dir():
+    return {}
+
+
+def install_extension(*args, **kargs):
+    pass
+
+
+def post_install():
+    pass
+
+
+def precompile_hock(*args, **kargs):
+    pass
